// 7) Faca um programa que leia um numero inteiro positivo e determine se ele e ou nao
//    um numero primo. 
#include <stdio.h>
int main() {
    int numero, divisores = 0;

    printf("Digite um numero inteiro positivo: ");
    scanf("%d", &numero);

    if (numero > 0) {
        for (int i = 1; i <= numero; i++) {
            if (numero % i == 0) {
                divisores++;
            }
        }

        if (divisores == 2) {
            printf("%d e um numero primo.\n", numero);
        } else {
            printf("%d nao e um numero primo.\n", numero);
        }
    } else {
        printf("Numero invalido! Digite um numero positivo.\n");
    }

    return 0;
}


// 8) Elaborar um programa que faca uma contagem regressiva de 10 ate 1 e, no final exiba a 
//    mensagem fim do tempo.
#include <stdio.h>
int main() {

