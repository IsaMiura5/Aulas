// 3) Crie um programa que peca um numero inteiro positivo ao usuario e calcule o seu
      fatorial.
#include <stdio.h>
int main() {
    int numero;
    int fatorial = 1;

    printf("Digite um numero inteiro positivo: ");
    scanf("%d", &numero);

    if (numero >= 0) {
        for (int i = 1; i <= numero; i++) {
            fatorial = fatorial * i;
        }

        printf("O fatorial de %d e: %d\n", numero, fatorial);
    } else {
        printf("Numero invalido! Digite um numero positivo.\n");
    }

    return 0;
}

